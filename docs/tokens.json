{
  "$description": "DraftMyListing design tokens (W3C DTCG). Source of truth for docs/design.md. Light values at the root; dark values under mode.dark use the same role names.",
  "color": {
    "bg": { "$type": "color", "$value": "#FFFFFF" },
    "surface": { "$type": "color", "$value": "#F6F7F9" },
    "text": { "$type": "color", "$value": "#1A1D21" },
    "text-muted": { "$type": "color", "$value": "#5B6470" },
    "border": { "$type": "color", "$value": "#8A929C" },
    "primary": { "$type": "color", "$value": "#1F5FBF" },
    "primary-hover": { "$type": "color", "$value": "#184C99" },
    "on-primary": { "$type": "color", "$value": "#FFFFFF" },
    "success": { "$type": "color", "$value": "#1E7B3A" },
    "warning": { "$type": "color", "$value": "#8A5A00" },
    "danger": { "$type": "color", "$value": "#B42318" },
    "focus": { "$type": "color", "$value": "#1F5FBF" }
  },
  "mode": {
    "dark": {
      "color": {
        "bg": { "$type": "color", "$value": "#121417" },
        "surface": { "$type": "color", "$value": "#1C1F24" },
        "text": { "$type": "color", "$value": "#E8EAED" },
        "text-muted": { "$type": "color", "$value": "#A3ABB5" },
        "border": { "$type": "color", "$value": "#6B737D" },
        "primary": { "$type": "color", "$value": "#6EA8FF" },
        "primary-hover": { "$type": "color", "$value": "#8DBBFF" },
        "on-primary": { "$type": "color", "$value": "#0B1A33" },
        "success": { "$type": "color", "$value": "#4CC27A" },
        "warning": { "$type": "color", "$value": "#F0B44C" },
        "danger": { "$type": "color", "$value": "#FF7A6E" },
        "focus": { "$type": "color", "$value": "#6EA8FF" }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      }
    },
    "size": {
      "sm": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "xl": { "$type": "dimension", "$value": "24px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "line-height": {
      "body": { "$type": "number", "$value": 1.5 },
      "heading": { "$type": "number", "$value": 1.25 }
    }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "md": { "$type": "dimension", "$value": "8px" }
  },
  "size": {
    "touch-target": { "$type": "dimension", "$value": "48px" },
    "content-max": { "$type": "dimension", "$value": "420px" },
    "focus-ring": { "$type": "dimension", "$value": "2px" }
  }
}

# Names of the settings DraftMyListing reads. Keep the real file OUTSIDE the repo and point
# DRAFTMYLISTING_ENV_FILE at it, e.g. C:\Repos\.config\draftmylisting\runtime.env. Never commit it.

# Sandbox keyset (developer.ebay.com -> Application Keys -> Sandbox).
EBAY_SANDBOX_APP_ID=
EBAY_SANDBOX_CLIENT_SECRET=
# Short RuName alias (Name-Name-App-xxxxx), not the portal's sign-in link that contains it.
EBAY_SANDBOX_RUNAME=
# Long-lived token from the authorization code flow, for the sandbox test user.
EBAY_SANDBOX_REFRESH_TOKEN=

# Production keyset: same settings without the SANDBOX_ part.
EBAY_APP_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_REFRESH_TOKEN=

# eBay's own MCP server reads EBAY_CLIENT_ID / EBAY_CLIENT_SECRET / EBAY_REFRESH_TOKEN;
# its MCP client config maps these values onto those names.

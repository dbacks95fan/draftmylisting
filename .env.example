# Names of the local settings DraftMyListing reads. Copy to .env and fill in; never commit .env.
# Names match eBay's official MCP server (@ebay/npm-public-api-mcp) so one .env serves both servers.

# From your eBay developer keyset (developer.ebay.com -> Application Keys).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# "application" for public data, "user" for anything in your own seller account.
EBAY_TOKEN_TYPE=user

# User refresh token for the household eBay account (developer portal -> User Tokens).
EBAY_REFRESH_TOKEN=

# "sandbox" or "production". eBay's MCP server supports production only.
EBAY_API_ENV=sandbox
